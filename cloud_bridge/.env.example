# ── iDrive S3 (required for all commands) ─────────────────────────────────
# Find your endpoint in the iDrive e2 console under "Buckets"
# Format: https://[region].idriveobjects.com  or  https://s3.[region].idriveobjects.com
IDRIVE_S3_ENDPOINT=https://s3.us-east-1.idriveobjects.com
IDRIVE_S3_ACCESS_KEY=your_access_key_id
IDRIVE_S3_SECRET_KEY=your_secret_access_key
IDRIVE_S3_BUCKET=your-bucket-name

# ── Dropbox ────────────────────────────────────────────────────────────────
# Get a long-lived token from https://www.dropbox.com/developers/apps
# Create an app → Permissions: files.content.read + files.content.write
# Generate an access token under "OAuth 2" on the app settings page
DROPBOX_ACCESS_TOKEN=sl.your_dropbox_token_here

# ── pCloud ─────────────────────────────────────────────────────────────────
# Generate at https://my.pcloud.com/#page=settings&settings=tab-security (OAuth2)
# or use the pCloud developer portal: https://docs.pcloud.com/
PCLOUD_ACCESS_TOKEN=your_pcloud_access_token
# Set to "eu" if your pCloud account is on EU servers (eapi.pcloud.com)
PCLOUD_REGION=us

# ── iCloud ─────────────────────────────────────────────────────────────────
# Use an app-specific password, not your main Apple ID password.
# Generate at https://appleid.apple.com → Sign-In and Security → App-Specific Passwords
ICLOUD_APPLE_ID=your@apple.id
ICLOUD_PASSWORD=xxxx-xxxx-xxxx-xxxx
