[Unit]
Description=Radarr
After=network-online.target

[Container]
Image=ghcr.io/hotio/radarr
ContainerName=radarr
Environment=PUID=1000
Environment=PGID=1001
Environment=UMASK=002
Environment=TZ=UTC
PublishPort=7878:7878
Volume=/mnt/data/appdata/radarr:/config
Volume=/mnt/data/data:/data
Network=media.network
AutoUpdate=registry
Notify=healthy
HealthCmd=curl -sf http://localhost:7878/ping
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=60s
HealthTimeout=10s

[Service]
Restart=unless-stopped
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
