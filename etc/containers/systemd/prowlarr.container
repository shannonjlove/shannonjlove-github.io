[Unit]
Description=Prowlarr (ProtonVPN)
After=network-online.target

[Container]
Image=ghcr.io/hotio/prowlarr
ContainerName=prowlarr
Environment=PUID=1000
Environment=PGID=1001
Environment=UMASK=002
Environment=TZ=UTC
Environment=VPN_ENABLED=true
Environment=VPN_CONF=wg0
Environment=VPN_PROVIDER=proton
Environment=VPN_LAN_NETWORK=192.168.0.0/24
Environment=VPN_LAN_LEAK_ENABLED=false
Environment=VPN_EXPOSE_PORTS_ON_LAN=9696/tcp
Environment=WEBUI_PORTS=9696/tcp
PublishPort=9696:9696
Volume=/mnt/data/appdata/prowlarr:/config
Network=media.network
AddCapability=NET_ADMIN
Sysctl=net.ipv4.conf.all.src_valid_mark=1
Secret=wg0_proton,type=mount,target=/config/wireguard/wg0.conf
AutoUpdate=registry
Notify=healthy
HealthCmd=curl -sf http://localhost:9696/ping
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=60s
HealthTimeout=10s

[Service]
Restart=unless-stopped
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
