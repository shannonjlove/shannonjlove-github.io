# =============================================================================
# SJL ExifTool Config — Shannon J. Love | shannonjlove.cloud
# Defines the custom XMP-SJL namespace for all SJL file processing.
#
# Covers 300+ tags sourced from:
#   - master_metadata_tags.md  (General, Image/Video, Camera, Date, Audio,
#                                Spotlight, Misc categories)
#   - sjlcrafthandofftemplate.md (PARA codes, DOCID, version, SHA, sensitivity)
#   - Core SJL system fields  (UUID24, PARA routing, location, links, TagBot)
#
# Install:
#   cp sjl.ExifTool_config ~/.ExifTool_config          # per-user (Mac or Linux)
#   cp sjl.ExifTool_config /root/.ExifTool_config      # root on server
#   cp sjl.ExifTool_config /opt/exiftool/.ExifTool_config  # project-local
#
# Usage in scripts:
#   exiftool -config /opt/exiftool/.ExifTool_config -XMP-SJL:SJLuuid24="..." file.jpg
#   OR install to ~/.ExifTool_config and omit the -config flag entirely.
#
# Tag prefix is always XMP-SJL: (e.g. -XMP-SJL:SJLuuid24, NOT -XMP:SJLuuid24)
# =============================================================================

%Image::ExifTool::UserDefined = (

    # Hook the SJL namespace into ExifTool's XMP main table
    'Image::ExifTool::XMP::Main' => {
        SJL => {
            SubDirectory => {
                TagTable => 'Image::ExifTool::UserDefined::SJL',
            },
        },
    },
);

