# /etc/sjl-rclone-tokens.env — rclone OAuth tokens for SJL cloud storage
# Copy this file to /etc/sjl-rclone-tokens.env on the VPS and fill in the
# token JSON from your rclone authorize output. chmod 600 after writing.
#
# Get tokens by running:
#   rclone authorize dropbox --auth-no-open-browser   (repeat for each account)
#   rclone authorize pcloud --auth-no-open-browser
#
# Each token is a single-line JSON blob from the "Paste the following" output.

# Dropbox FCPXServerSJL@gmail.com
DROPBOX_FCPX_TOKEN='{"access_token":"PASTE_TOKEN_JSON_HERE","token_type":"bearer","refresh_token":"PASTE_REFRESH_TOKEN_HERE","expiry":"...","expires_in":14400}'

# Dropbox shannonjlove@mac.com
DROPBOX_SJL_TOKEN='{"access_token":"PASTE_TOKEN_JSON_HERE","token_type":"bearer","refresh_token":"PASTE_REFRESH_TOKEN_HERE","expiry":"...","expires_in":14400}'

# pCloud SJL account
PCLOUD_TOKEN='{"access_token":"PASTE_TOKEN_JSON_HERE","token_type":"bearer","expiry":"0001-01-01T00:00:00Z"}'
